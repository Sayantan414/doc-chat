# Copy this file to .env and adjust the values for your machine.
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Docker Postgres with pgvector (ragdb container, mapped to port 5434)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/postgres

# Optional: port of the API server (default 3000)
PORT=3000

# Redis (docker compose service "redis"): job queue and answer cache
REDIS_URL=redis://localhost:6379

# Which model writes the answers: "ollama" (local, CHAT_MODEL above) or "groq" (online).
# Embeddings always stay local (EMBED_MODEL), so the stored vectors keep working.
CHAT_PROVIDER=ollama
# Groq: create a key at https://console.groq.com/keys (needed only when CHAT_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
